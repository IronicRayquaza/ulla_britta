# ── Core ────────────────────────────────────────────────────────────────────
PORT=3000
# Origin of the deployed dashboard, so CORS allows it. Comma-separated for several.
FRONTEND_URL=http://localhost:3000

# ── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Required. Webhooks are rejected outright when this is unset. Also signs the
# OAuth state below, so a callback cannot be pointed at another user's account.
GITHUB_WEBHOOK_SECRET=

# ── Acting as the user (optional) ───────────────────────────────────────────
# The installation token cannot create a repository on a PERSONAL account, star,
# follow, read notifications or create a gist — GitHub refuses those to anything
# that is not the person. Set these (from the same GitHub App's settings, with
# "Request user authorization (OAuth) during installation" enabled) and the user
# can connect their account once from the dashboard.
#
# Leave them unset and those seven tools fail with a clear explanation instead;
# everything else works unchanged. See docs/AGENT_CAPABILITIES.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# This server's public origin, used to build the OAuth redirect. With it unset,
# GitHub falls back to the callback URL configured on the App itself.
PUBLIC_URL=

# ── Model providers ─────────────────────────────────────────────────────────
# At least one is required. Gemini is primary, Groq takes over when it throttles.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ────────────────────────────────────────────────────────────────
# Service role key: server-side only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Queue ───────────────────────────────────────────────────────────────────
# Render provides this as REDIS_INTERNAL_URL. Required in production.
REDIS_URL=redis://localhost:6379

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Fallback recipient only. Each user's address comes from user_preferences.email.
EMAIL_RECIPIENT=
# EMAIL_FROM="Ulla Britta <onboarding@resend.dev>"

# ── Vercel (optional) ───────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_WEBHOOK_SECRET=
# SENTINEL_INTERVAL_MS=120000
# DISABLE_SENTINEL=false

# ── Maintenance sweep ───────────────────────────────────────────────────────
# MAINTENANCE_MAX_REPOS=10
